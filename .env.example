APP_NAME="Odessa Oil"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PREVIOUS_KEYS=

APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos -----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=odessaoil
DB_USERNAME=
DB_PASSWORD=

# --- Sesión ------------------------------------------------------------
# SESSION_SECURE_COOKIE debe ser true en producción (exige HTTPS).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correo ------------------------------------------------------------
# La recuperación de contraseña depende de esto en producción.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-responder@ejemplo.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=

AUTH_PASSWORD_RESET_EXPIRE=60
AUTH_PASSWORD_RESET_THROTTLE=60

# --- Reglas de negocio -------------------------------------------------
# Días de antelación con que una pieza pasa a "próximo a vencer".
ODESSA_EXPIRY_WARNING_DAYS=60
# Vigencia por defecto cuando el servicio no define la suya.
ODESSA_DEFAULT_VALIDITY_DAYS=365
# Disco privado de documentos. Nunca debe apuntar dentro de public/.
ODESSA_DOCUMENTS_DISK=documents
ODESSA_UPLOAD_MAX_KB=20480
ODESSA_DOWNLOAD_TTL=5

# --- Ventana de recertificación ----------------------------------------
# Un equipo no puede perder la certificación mientras está en el taller,
# así que hay que avisarle al cliente ANTES de que sea tarde para mandarlo:
#
#   fecha límite de envío = vencimiento - reparación - margen de seguridad
#
# Cuánto tarda Odessa en devolver un equipo.
ODESSA_TURNAROUND_DAYS=30
# Colchón sobre esa demora, para que el aviso no llegue justo.
ODESSA_SAFETY_MARGIN_DAYS=15
# Con cuántos días de antelación se avisa al cliente.
ODESSA_RECERT_NOTICE_DAYS=30
# Día de la semana del resumen al superadministrador (1 = lunes).
ODESSA_RECERT_DIGEST_DAY=1
# Casilla de Odessa que recibe copia de cada aviso.
ODESSA_RECERT_COPY_TO=

# --- Datos de demostración ---------------------------------------------
# Si se deja vacío, el seeder genera una contraseña al azar y la muestra
# una sola vez por consola. Nunca queda guardada en el repositorio.
DEMO_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# --- Inertia DevTools --------------------------------------------------
# Grabador de peticiones de la extensión de Chrome. Escribe un archivo por
# petición en storage/inertia-devtools tomando un lock exclusivo, así que si
# quedan dos `artisan serve` vivos a la vez las peticiones se bloquean hasta
# agotar max_execution_time. No hace falta para desarrollar: queda apagado.
INERTIA_DEVTOOLS_ENABLED=false

